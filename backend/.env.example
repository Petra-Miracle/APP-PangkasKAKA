# ============================================================
# PangkasKAKA Backend — Environment Variables
# ============================================================
# Copy file ini jadi `.env` di folder backend/, lalu isi nilai asli.
# JANGAN PERNAH commit file `.env` (sudah di-cover .gitignore root).
# Untuk hosting (Railway/Render/dst), isi variabel-variabel ini
# lewat dashboard "Environment Variables", bukan lewat file.

# ---------- App ----------
# "development" (default) atau "production".
# production = mematikan auto-seed demo data & memaksa PAYMENT_MODE bukan simulation.
ENVIRONMENT=development

# Comma-separated, mis: https://app.pangkaskaka.id,https://admin.pangkaskaka.id
# "*" (default) aman untuk mobile-only. Wajib dipersempit begitu ada web client.
CORS_ORIGINS=*

# ---------- Database ----------
# Lokal (docker/mongod): mongodb://localhost:27017
# MongoDB Atlas: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net
MONGO_URL=mongodb://localhost:27017
DB_NAME=pangkaskaka

# ---------- Auth (JWT) ----------
# WAJIB string acak & panjang, beda antara dev/staging/production.
# Generate baru dengan: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_GENERATE_A_NEW_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_EXP_HOURS=168

# ---------- AI Face Scan (reasoning text only — shape itself is on-device) ----------
# Generate gratis di https://aistudio.google.com/apikey
# Kalau kosong, fitur tetap jalan pakai kalimat template (fallback), tanpa AI.
GEMINI_API_KEY=

# ---------- Email (Brevo HTTP API — forgot-password OTP) ----------
# Pakai HTTP API (bukan SMTP mentah) karena Railway memblokir koneksi SMTP
# keluar (port 465/587) di level jaringan. "From" tetap alamat Gmail tim
# lewat fitur "Single Sender Verification" Brevo (gratis, tanpa perlu punya
# domain sendiri — gmail.com bukan domain milik kita jadi tidak bisa
# diverifikasi penuh, tapi single-sender cukup untuk kirim atas nama alamat ini):
# 1. Daftar gratis di https://app.brevo.com
# 2. Settings > Senders, Domains & Dedicated IPs > Senders > Add a Sender
#    -> isi email pangkaskaka26@gmail.com -> Brevo kirim link verifikasi ke
#    inbox itu -> klik link-nya
# 3. Settings > SMTP & API > API Keys > Generate a new API key -> salin ke sini
# Kalau kosong, kode reset tetap dibuat & disimpan tapi TIDAK terkirim (hanya di-log) — cukup untuk dev.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=pangkaskaka26@gmail.com
BREVO_SENDER_NAME=PangkasKAKA

# ---------- Payment (Durianpay) ----------
# simulation = mock lokal (default, aman untuk dev tanpa akun Durianpay)
# sandbox    = pakai dp_test_ key, untuk staging/testing end-to-end
# production = pakai dp_live_ key, HANYA untuk go-live
PAYMENT_MODE=simulation
DURIANPAY_API_KEY=
DURIANPAY_API_BASE=https://api.durianpay.id/v1
DURIANPAY_PAYMENT_LINK_BASE=https://links.durianpay.id/payment
# Public Key (RSA-2048) dari Durianpay Dashboard > Settings > Webhook
# Pakai literal \n di dalam string (bukan baris baru sungguhan)
DURIANPAY_PUBLIC_KEY_PEM=
# Opsional, fallback HMAC bila public key belum di-set
DURIANPAY_WEBHOOK_SECRET=

# ---------- Object Storage (Cloudflare R2) ----------
# Kalau kosong, upload foto/dokumen fallback ke perilaku lama (base64 disimpan
# langsung di MongoDB) — aman untuk dev lokal tanpa akun R2, tapi JANGAN kosong
# di production (lihat Noted/kebutuhan-infrastruktur-functional.md).
# Dashboard: https://dash.cloudflare.com -> Storage & databases -> R2 Object Storage
# -> Manage R2 API Tokens -> Create Account API token (permission: Object Read & Write)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=pangkaskaka-uploads
# Public Development URL bucket (atau custom domain kalau sudah disambungkan)
R2_PUBLIC_URL=
