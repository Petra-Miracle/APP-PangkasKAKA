# ============================================================
# PangkasKAKA Frontend (Expo) — Environment Variables
# ============================================================
# Copy file ini jadi `.env` di folder frontend/, lalu isi nilai asli.
# Variabel EXPO_PUBLIC_* akan ter-bundle ke dalam app — JANGAN taruh
# secret di sini, hanya URL/konfigurasi publik.

# URL backend FastAPI (tanpa trailing slash, tanpa /api di akhir)
# Dev lokal:   http://localhost:8000
# Production:  https://api.pangkaskaka.id (ganti sesuai domain hosting kamu)
EXPO_PUBLIC_BACKEND_URL=http://localhost:8000
